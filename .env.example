# Copy to .env. Use the dedicated database/user created in README.
# URL-encode special password characters: @ -> %40, # -> %23, % -> %25
DATABASE_URL=postgresql://tilestock_app:CHANGE_ME@127.0.0.1:5432/tilestock
BUSINESS_NAME=Shivam Tiles
CURRENCY=INR
# Optional full path to the matching PostgreSQL bin directory (backup helper).
PG_BIN=C:\Program Files\PostgreSQL\18\bin
# Optional existing Google Drive for desktop synced folder. Leave blank to disable.
CLOUD_BACKUP_DIR=

# Optional authenticator encryption-key file. Default: .security/auth.key
# Keep the matching key in a separate secure backup; never publish it.
# AUTH_KEY_FILE=C:\SecureFolder\ShivamTiles\auth.key
